#include <iostream>
using namespace std;

int main() {
    int row = 1;

    while (row <= 5) {
        int space = 1;
        int col = 1;

        while (space <= 5 - row) {
            cout << " ";
            space++;
        }

        while (col <= row) {
            cout << "*";
            col++;
        }

        cout << endl;
        row++;
    }

    return 0;
}
