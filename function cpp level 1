#include <iostream>
#include <string>
using namespace std;

void sapa(string nama) {
    cout << "Halo, " << nama << "!" << endl;
}

int tambah(int a, int b) {
    return a + b;
}

int main() {
    sapa("Joy");
    sapa("Seulgi");

    int hasil = tambah(5, 3);
    cout << "Hasil: " << hasil << endl;
    return 0;
}
