const produk = ["Laptop", "Mouse", "Keyboard", "Monitor", "Headset"];

const idx = produk.indexOf("Keyboard");
if (idx !== -1) {
  console.log(`Produk "Keyboard" ditemukan di index ke-${idx}`);
} else {
  console.log('Produk "Keyboard" tidak ditemukan');
}

const produkPanjang = produk.filter((x) => x.length > 5);
console.log("Produk dengan panjang > 5:", produkPanjang);
